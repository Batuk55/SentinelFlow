{
  "rules": {
    "failed_login_bruteforce": {
      "enabled": true,
      "category": "Brute Force Attack",
      "window_seconds": 60,
      "threshold": 5,
      "severity": "High",
      "escalation": [{"at": 20, "severity": "Critical"}]
    },
    "high_connection_frequency": {
      "enabled": true,
      "category": "Abnormal Connection Frequency",
      "window_seconds": 60,
      "threshold": 100,
      "severity": "High",
      "escalation": [{"at": 500, "severity": "Critical"}]
    },
    "port_scan_pattern": {
      "enabled": true,
      "category": "Port Scanning",
      "window_seconds": 60,
      "threshold": 15,
      "severity": "High",
      "escalation": [{"at": 50, "severity": "Critical"}]
    },
    "suspicious_port_activity": {
      "enabled": true,
      "category": "Suspicious Port Activity",
      "window_seconds": 300,
      "threshold": 3,
      "severity": "Medium",
      "escalation": [{"at": 20, "severity": "High"}],
      "suspicious_ports": [23, 445, 1337, 3389, 4444, 5900, 6667, 31337],
      "suppressed_by": ["port_scan_pattern"]
    },
    "repeated_connections": {
      "enabled": true,
      "category": "Repeated Connections",
      "window_seconds": 300,
      "threshold": 15,
      "severity": "Low",
      "escalation": [{"at": 60, "severity": "Medium"}],
      "suppressed_by": ["high_connection_frequency", "port_scan_pattern"]
    },
    "unusual_destination_port": {
      "enabled": true,
      "category": "Unusual Destination Port",
      "window_seconds": 300,
      "threshold": 5,
      "severity": "Low",
      "expected_ports": [20, 21, 22, 25, 53, 80, 110, 123, 143, 443, 465, 587, 993, 995, 3306, 5432, 8080, 8443],
      "suppressed_by": ["port_scan_pattern", "suspicious_port_activity"]
    }
  }
}
